# Copy this file to .env and fill in your own Supabase project values.
# Find these under Supabase Dashboard -> Project Settings -> API.
# Use the anon/public key here — NEVER the service_role key.
# .env itself is git-ignored — never commit real credentials.

SUPABASE_URL=your_project_url
SUPABASE_KEY=your_anon_key
PORT=3000
